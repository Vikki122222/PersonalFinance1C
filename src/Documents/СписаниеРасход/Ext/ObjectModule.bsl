Процедура ОбработкаПроведения(Отказ, РежимПроведения)
 Блокировка = Новый БлокировкаДанных;
 ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОстаткиНаСчетах");
 ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
 ЭлементБлокировки.УстановитьЗначение("Счет", СчетСписания);
 Блокировка.Заблокировать();
 ЗапросОстатка = Новый Запрос;
 ЗапросОстатка.Текст = 
  "ВЫБРАТЬ
  | ОстаткиНаСчетахОстатки.СуммаОстаток КАК СуммаОстаток
  |ИЗ
  | РегистрНакопления.ОстаткиНаСчетах.Остатки(, Счет = &СчетСписания) КАК ОстаткиНаСчетахОстатки"; 
 ЗапросОстатка.УстановитьПараметр("СчетСписания", СчетСписания); 
 РезультатОстатка = ЗапросОстатка.Выполнить();
 ВыборкаОстатка = РезультатОстатка.Выбрать(); 
 ТекущийОстаток = 0; 
 Если ВыборкаОстатка.Следующий() Тогда
  Если ВыборкаОстатка.СуммаОстаток <> Неопределено И ВыборкаОстатка.СуммаОстаток <> Null Тогда
   ТекущийОстаток = ВыборкаОстатка.СуммаОстаток;
  КонецЕсли;
 КонецЕсли; 
 Если ТекущийОстаток < Сумма Тогда
  Отказ = Истина;
  Сообщить("Недостаточно средств на счете! Доступно: " + ТекущийОстаток + ", попытка списать: " + Сумма);
  Возврат;
 КонецЕсли;
 Движения.ОстаткиНаСчетах.Записывать = Истина;
 ДвижениеСчет = Движения.ОстаткиНаСчетах.Добавить();
 ДвижениеСчет.ВидДвижения = ВидДвиженияНакопления.Расход;
 ДвижениеСчет.Период = Дата;
 ДвижениеСчет.Счет = СчетСписания;
 ДвижениеСчет.Сумма = Сумма; 
 Движения.Расходы.Записывать = Истина;
 ДвижениеРасход = Движения.Расходы.Добавить();
 ДвижениеРасход.ВидДвижения = ВидДвиженияНакопления.Приход;
 ДвижениеРасход.Период = Дата;
 ДвижениеРасход.Категория = КатегорияРасхода;
 ДвижениеРасход.Сумма = Сумма;
 Движения.Бюджет.Записывать = Истина;
 ДвижениеБюджет = Движения.Бюджет.Добавить();
 ДвижениеБюджет.Период = Дата;
 ДвижениеБюджет.МесяцБюджета = НачалоМесяца(Дата); 
 ДвижениеБюджет.Категория = КатегорияРасхода;
 ДвижениеБюджет.Лимит = 0;
 ДвижениеБюджет.Использовано = Сумма;
 НачПериода = НачалоМесяца(Дата);
 КонПериода = КонецМесяца(Дата); 
 ЗапросБюджет = Новый Запрос;
 ЗапросБюджет.Текст = 
  "ВЫБРАТЬ
  | ЕСТЬNULL(БюджетОбороты.ЛимитОборот, 0) КАК Лимит,
  | ЕСТЬNULL(БюджетОбороты.ИспользованоОборот, 0) КАК Использовано
  |ИЗ
  | РегистрНакопления.Бюджет.Обороты(&НачПериода, &КонПериода, , Категория = &Категория И МесяцБюджета = &МесяцБюджета) КАК БюджетОбороты";  
 ЗапросБюджет.УстановитьПараметр("НачПериода", НачПериода);
 ЗапросБюджет.УстановитьПараметр("КонПериода", КонПериода);
 ЗапросБюджет.УстановитьПараметр("Категория", КатегорияРасхода);
 ЗапросБюджет.УстановитьПараметр("МесяцБюджета", НачПериода); 
 РезультатБюджет = ЗапросБюджет.Выполнить().Выбрать();
 ЛимитБюджета = 0;
 ФактТрат = Сумма; 
 Если РезультатБюджет.Следующий() Тогда
  ЛимитБюджета = РезультатБюджет.Лимит;
  ФактТрат = ФактТрат + РезультатБюджет.Использовано;
 КонецЕсли;
 Сообщить("[ОТЛАДКА] Лимит в базе: " + ЛимитБюджета + " | Всего факта с учетом этого документа: " + ФактТрат); 
 Если ЛимитБюджета > 0 И ФактТрат > ЛимитБюджета Тогда
  ПревышениеЧисление = ФактТрат - ЛимитБюджета;
  Сообщение = Новый СообщениеПользователю;
  Сообщение.Текст = "Внимание! Лимит по категории '" + КатегорияРасхода + "' превышен на " + ПревышениеЧисление + " руб. Расход учтен.";
  Сообщение.Сообщить();
 КонецЕсли; 
КонецПроцедуры